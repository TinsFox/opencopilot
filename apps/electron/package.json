{
  "name": "@opencopilot/electron",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "electron",
  "author": {
    "name": "TinsFox"
  },
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "tsdown",
    "build:app": "pnpm --dir ../web build && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "node ./scripts/dev.mjs",
    "postinstall": "electron-builder install-app-deps",
    "package:dir": "pnpm build:app && electron-builder --dir --config electron-builder.yml",
    "package:linux": "pnpm build:app && electron-builder --linux --config electron-builder.yml",
    "package:mac": "pnpm build:app && electron-builder --mac --config electron-builder.yml",
    "package:win": "pnpm build:app && electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.37",
    "@libsql/client": "^0.17.2",
    "ai": "^6.0.134",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.44.7",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@opencopilot/shared": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "tsdown": "^0.21.4"
  }
}
