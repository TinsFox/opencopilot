{
  "name": "@opencopilot/electron",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main/index.cjs",
  "description": "electron",
  "author": {
    "name": "TinsFox"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "tsdown",
    "build:app": "pnpm --dir ../web build && pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "electron-builder install-app-deps",
    "package:dir": "pnpm build:app && electron-builder --dir --config electron-builder.yml",
    "package:win": "pnpm build:app && electron-builder --win --config electron-builder.yml",
    "package:mac": "pnpm build:app && electron-builder --mac --config electron-builder.yml",
    "package:linux": "pnpm build:app && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@opencopilot/shared": "workspace:*",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "tsdown": "^0.21.4"
  }
}
