{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Electron Dev Script",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceRoot}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"]
    },
    {
      "name": "Debug Renderer Process",
      "port": 9222,
      "request": "attach",
      "type": "chrome",
      "webRoot": "${workspaceFolder}/apps/web",
      "timeout": 60000,
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug All",
      "configurations": ["Debug Electron Dev Script", "Debug Renderer Process"],
      "presentation": {
        "order": 1
      }
    }
  ]
}
