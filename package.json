{
  "name": "opencopilot",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @opencopilot/electron dev",
    "build": "pnpm build:web && pnpm build:electron",
    "build:web": "pnpm --filter @opencopilot/web build",
    "build:electron": "pnpm --filter @opencopilot/electron build",
    "build:dir": "pnpm build && pnpm --filter @opencopilot/electron package:dir",
    "build:win": "pnpm build && pnpm --filter @opencopilot/electron package:win",
    "build:mac": "pnpm build && pnpm --filter @opencopilot/electron package:mac",
    "build:linux": "pnpm build && pnpm --filter @opencopilot/electron package:linux",
    "lint": "eslint --cache .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.15",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
